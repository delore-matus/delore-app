{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeLore",
  "version": "0.1.0",
  "identifier": "com.delore.gpuswarm",
  "build": {
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "../"
    },
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "../"
    },
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DeLore Provider",
        "width": 920,
        "height": 820,
        "minWidth": 640,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost https://cdn.jsdelivr.net http://127.0.0.1:1420 ws://127.0.0.1:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": ["icons/icon.ico"],
    "shortDescription": "DeLore TESTNET provider",
    "longDescription": "The DeLore desktop app for participating in the GPU Swarm TESTNET."
  }
}
