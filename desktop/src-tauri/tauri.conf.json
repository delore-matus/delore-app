{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeLore",
  "version": "0.1.0",
  "identifier": "com.delore.gpuswarm",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DeLore Provider",
        "width": 920,
        "height": 820,
        "minWidth": 640,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420"
    }
  },
  "bundle": {
    "active": false
  }
}
